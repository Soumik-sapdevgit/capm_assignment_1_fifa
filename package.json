{
  "name": "capm_assignment_1",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "sqlite3": "^6.0.1"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "database": "local.db"
          }
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "Soumik": {
              "name": "Soumik",
              "password": "Soumik",
              "roles": [
                "FifaViewer"
              ]
            },
            "TeamManager": {
              "name": "TeamManager",
              "password": "TeamManager",
              "roles": [
                "FifaViewer",
                "FifaManager"
              ]
            },
            "Admin": {
              "name": "Admin",
              "password": "Admin",
              "roles": [
                "FifaViewer",
                "FifaManager",
                "FifaAdmin"
              ]
            }
          }
        }
      }
    }
  },
  "private": true
}